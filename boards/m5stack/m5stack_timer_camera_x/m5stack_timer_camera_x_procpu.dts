/dts-v1/;

#include <espressif/esp32/esp32.dtsi>
#include "m5stack_timer_camera_x-pinctrl.dtsi"
#include "grove_connectors.dtsi"
#include <espressif/partitions_0x1000_amp.dtsi>

/ {
	model = "M5Stack Timer Camera X PROCPU";
	compatible = "m5stack,timer-camera-x";

	aliases {
		led0 = &blue_led;
		uart-0 = &uart0;
		i2c-0 = &i2c0;
		watchdog0 = &wdt0;
		rtc = &bm8563;
	};

	chosen {
		zephyr,sram = &sram1;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,rtc = &bm8563;
		zephyr,bt-hci = &esp32_bt_hci;
	};

	leds {
		compatible = "gpio-leds";

		blue_led: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Blue - LED0";
		};
	};

	/*
	 * The battery reaches the system through a switch that the power
	 * button or the RTC interrupt close and that this pin keeps closed.
	 * Disabling the regulator on battery power turns the board off.
	 */
	bat_hold: bat_hold {
		compatible = "regulator-fixed";
		regulator-name = "bat_hold";
		enable-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};

	vbat: vbat {
		compatible = "voltage-divider";
		io-channels = <&adc0 2>;
		output-ohms = <2670>;
		full-ohms = <(1370 + 2670)>;
		skip-calibration;
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(4)>;
	ranges = <0x0 0x0 DT_SIZE_M(4)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&gpio0 {
	gpio-reserved-ranges = <6 6>, <16 2>, <20 1>, <24 1>, <28 4>;
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* RTC BM8563 */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	sda-gpios = <&gpio0 12 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 14 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	bm8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
	};
};

/* Grove port */
&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	sda-gpios = <&gpio0 4 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 13 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* Battery voltage, GPIO38 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&timer0 {
	status = "okay";
};

&timer1 {
	status = "okay";
};

&timer2 {
	status = "okay";
};

&timer3 {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};
