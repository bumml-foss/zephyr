if BOARD_M5STACK_TIMER_CAMERA_X_ESP32_PROCPU

config ESP_SPIRAM
	default y if !MCUBOOT

choice SPIRAM_TYPE
	default SPIRAM_TYPE_ESPPSRAM64
endchoice

endif # BOARD_M5STACK_TIMER_CAMERA_X_ESP32_PROCPU
